# Copy this file to .env and adjust as needed. All values are optional.

# Open-Meteo (no API key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_META_URL=https://api.open-meteo.com/data

# NOAA Aviation Weather Center METAR API (station observations, no key required)
METAR_URL=https://aviationweather.gov/api/data/metar

# HTTP timeout per request, in seconds
REQUEST_TIMEOUT_SECONDS=15

# How long successful API responses are cached, in seconds
CACHE_TTL_SECONDS=600

# Location selected on startup (must be a key in data/locations.py)
DEFAULT_LOCATION=Ulaanbaatar

# Only use a station observation if the station is within this distance of the location
OBSERVATION_MAX_DISTANCE_KM=50

# Observations older than this are shown as unavailable rather than current
OBSERVATION_MAX_AGE_HOURS=2

# Number of forecast days to request (1-16)
FORECAST_DAYS=7

# --- Telegram notifications (notify.py) -------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat / group / channel id that receives the messages (e.g. 123456789 or -100...)
TELEGRAM_CHAT_ID=
# Comma-separated city names from data/locations.py (default: DEFAULT_LOCATION)
TELEGRAM_LOCATIONS=Ulaanbaatar
